# EvalAgent 环境变量配置
# 复制此文件为 .env 并填入实际值

# LLM Provider: "openai" 或 "dashscope"
LLM_PROVIDER=openai

# DeepSeek / OpenAI 兼容 API
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL_NAME=deepseek-v4-flash

# 被测模型（System Under Test）
TARGET_MODEL_NAME=deepseek-v4-flash
TARGET_TEMPERATURE=0.3

# 对比模型
COMPARE_MODEL_NAME=gpt-4o-mini
COMPARE_MODEL_TEMPERATURE=0.3

# 评测参数
MAX_TURNS=8
EVAL_TEMPERATURE=0.3
SIM_TEMPERATURE=0.9
NUM_EVALS_PER_SCENARIO=3
